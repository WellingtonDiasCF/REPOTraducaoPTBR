<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>RepoPTBRContextual</AssemblyName>
    <RootNamespace>RepoPTBRContextual</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\REPO</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(MSBuildProjectDirectory)\..\..\payload\BepInEx\core</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(GameDir)\REPO_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)\0Harmony.dll" Private="false" />
    <Reference Include="Unity.Localization" HintPath="$(GameDir)\REPO_Data\Managed\Unity.Localization.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameDir)\REPO_Data\Managed\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameDir)\REPO_Data\Managed\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDir)\REPO_Data\Managed\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameDir)\REPO_Data\Managed\UnityEngine.UI.dll" Private="false" />
  </ItemGroup>
</Project>
